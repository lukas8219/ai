# Copy this file to .env and fill in your credentials

# Gmail API credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost
GMAIL_REFRESH_TOKEN=

# Slack API Token
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=C12345678,C87654321 # Comma separated list of channel IDs to fetch messages from

# HelpScout API credentials
HELPSCOUT_API_KEY=
HELPSCOUT_API_SECRET=
HELPSCOUT_API_ACCOUNT_ID=

# GitHub API Token
GITHUB_TOKEN=
